# Copy to ".env" for local testing:  cp .env.example .env
# (On GitHub these become repository "Secrets", not a file.)

# --- Gmail account 1 ---
GMAIL_USER_1=you@gmail.com
GMAIL_APP_PASSWORD_1=abcd efgh ijkl mnop   # 16-char Google App Password

# --- Gmail account 2 ---
GMAIL_USER_2=second@gmail.com
GMAIL_APP_PASSWORD_2=abcd efgh ijkl mnop

# --- Groq (free AI summaries) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- Optional tuning ---
# MICROSOFT_KEYWORDS=microsoft,msft,internship
# LOOKBACK_MINUTES=30
# ONLY_INTERNSHIP=false   # set true to ONLY get pinged about the internship result
